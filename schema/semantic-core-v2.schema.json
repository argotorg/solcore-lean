{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solcore:semantic-core:v2",
  "title": "Solcore Semantic Core program v2",
  "description": "The strict, versioned wire representation of a closed-candidate Solcore Semantic Core program with pure primitive operations. Well-typedness is checked after decoding.",
  "$ref": "#/$defs/program",
  "$defs": {
    "nat": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "unit",
        "bool",
        "word"
      ]
    },
    "word256": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "unitExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "unit"
        }
      },
      "required": [
        "tag"
      ]
    },
    "boolExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "bool"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "tag",
        "value"
      ]
    },
    "wordExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "word"
        },
        "value": {
          "$ref": "#/$defs/word256"
        }
      },
      "required": [
        "tag",
        "value"
      ]
    },
    "varExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "var"
        },
        "index": {
          "$ref": "#/$defs/nat"
        }
      },
      "required": [
        "tag",
        "index"
      ]
    },
    "unaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "unary"
        },
        "op": {
          "type": "string",
          "enum": [
            "boolNot",
            "wordNot"
          ]
        },
        "operand": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "tag",
        "op",
        "operand"
      ]
    },
    "binaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "binary"
        },
        "op": {
          "type": "string",
          "enum": [
            "wordAdd",
            "wordSub",
            "wordMul",
            "wordDiv",
            "wordMod",
            "wordEq",
            "wordGt",
            "wordAnd",
            "wordOr",
            "wordXor",
            "wordShl",
            "wordShr"
          ]
        },
        "left": {
          "$ref": "#/$defs/expr"
        },
        "right": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "tag",
        "op",
        "left",
        "right"
      ]
    },
    "letExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "let"
        },
        "initializer": {
          "$ref": "#/$defs/expr"
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "tag",
        "initializer",
        "body"
      ]
    },
    "ifExpr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "const": "if"
        },
        "condition": {
          "$ref": "#/$defs/expr"
        },
        "thenBranch": {
          "$ref": "#/$defs/expr"
        },
        "elseBranch": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "tag",
        "condition",
        "thenBranch",
        "elseBranch"
      ]
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/unitExpr"
        },
        {
          "$ref": "#/$defs/boolExpr"
        },
        {
          "$ref": "#/$defs/wordExpr"
        },
        {
          "$ref": "#/$defs/varExpr"
        },
        {
          "$ref": "#/$defs/unaryExpr"
        },
        {
          "$ref": "#/$defs/binaryExpr"
        },
        {
          "$ref": "#/$defs/letExpr"
        },
        {
          "$ref": "#/$defs/ifExpr"
        }
      ]
    },
    "value": {
      "description": "A canonical Semantic Core value; the three literal expression encodings are reused deliberately.",
      "oneOf": [
        {
          "$ref": "#/$defs/unitExpr"
        },
        {
          "$ref": "#/$defs/boolExpr"
        },
        {
          "$ref": "#/$defs/wordExpr"
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "solcore-semantic-core/v2"
        },
        "resultType": {
          "$ref": "#/$defs/type"
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      },
      "required": [
        "schema",
        "resultType",
        "body"
      ]
    }
  }
}
