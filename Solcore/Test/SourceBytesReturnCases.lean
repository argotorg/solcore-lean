import Solcore.Synthesis.Source.BytesReturnCases

/-! Generated bytes-return cases. The Core contract must equal the source model,
a slot map and std's encoder, on every transaction of the generated sequences;
each case must replay to itself; the shell node count must be the one the
definitions fix; generation must draw every bank length; and every reduction
must be a strictly smaller sealed case that replays. -/
set_option autoImplicit false

namespace Tests.SourceBytesReturnCases

open Lean
open Solcore.Core (Word)
open Solcore.ContractRuntime
open Solcore.Synthesis.Core
open Solcore.Synthesis.Stateful
open Solcore.Synthesis.Stateful.BytesReturnExecution (Transaction)

private def get {α : Type} (result : Except String α) : IO α :=
  match result with
  | .ok value => pure value
  | .error error => throw (IO.userError error)

private def ensure (condition : Bool) (message : String) : IO Unit :=
  unless condition do throw (IO.userError message)

private def slots (values : List Word) : Json :=
  toJson ((values.zipIdx).map fun (value, slot) => Json.mkObj [
    ("slot", toJson (toString slot)), ("value", toJson (toString value.val))])

/-- The Core rows of a scenario equal the model's, transaction by transaction. -/
private def sameAsModel (scenario : Solcore.Synthesis.Source.BytesReturn.CheckedScenario) (fuel : Nat) (name : String) :
    IO Unit := do
  let history := Solcore.Synthesis.Source.BytesReturn.observe scenario StorageExecution.fixtureBindings fuel
  ensure ((history.getObjValAs? String "status").toOption == some "complete") s!"{name}: history incomplete"
  let rows ← get (history.getObjValAs? (Array Json) "transactions")
  let some modelled := BytesReturnExecution.model scenario.plan.step fuel scenario.transactions
    | throw (IO.userError s!"{name}: the source model failed")
  ensure (rows.size == modelled.length) s!"{name}: a row is missing"
  for ((row, model), transaction) in (rows.toList.zip modelled).zip scenario.transactions do
    ensure ((row.getObjValAs? String "status").toOption == some (if model.reverted then "reverted" else "returned") &&
        (row.getObjValAs? String "output").toOption == some (encodeBytesText model.output) &&
        (row.getObjVal? "committedStorage").toOption == some (slots model.slots))
      s!"{name}: the Core row differs from the source model: {row.compress}"
    -- A return carries the head and the padded data, a revert one Word.
    let length := transaction.length.val
    ensure (model.output.size == if model.reverted then 32 else 64 + 32 * ((length + 31) / 32))
      s!"{name}: the output has the wrong size"

def testSourceBytesReturnCases : IO Unit := do
  let fuel := 1000000
  ensure (BytesReturn.shellNodes == 125) s!"the shell has {BytesReturn.shellNodes} nodes"
  ensure (Solcore.Synthesis.Source.BytesReturn.maxProgramNodes == 512) "the case limit changed"
  -- Random generation: revision three with eight transactions, and the fixed
  -- corpora's revision one with three.
  let mut lengths : List Nat := []
  let mut cases : Array Json := #[]
  for (revision, transactions, count) in [(GeneratorRevision.v3, 8, 40), (GeneratorRevision.v1, 3, 24)] do
    let corpus := Solcore.Synthesis.Source.BytesReturn.generateCases (Seed.ofNat 1) 384 count 512 fuel revision transactions
    ensure ((corpus.getObjValAs? String "status").toOption == some "complete") s!"{revision.version}: generation exhausted"
    let generated ← get (corpus.getObjValAs? (Array Json) "cases")
    for (json, index) in generated.zipIdx do
      let name := s!"{revision.version} case {index}"
      ensure ((Solcore.Synthesis.Source.BytesReturn.replayCase json fuel).toOption == some json) s!"{name}: replay differs"
      let scenario ← get (Solcore.Synthesis.Source.BytesReturn.caseProgram json)
      ensure (scenario.transactions.length == transactions) s!"{name}: wrong sequence length"
      sameAsModel scenario fuel name
      let source ← get (json.getObjValAs? String "source")
      ensure ((source.splitOn "public returns (memory<bytes>) {").length == 2)
        s!"{name}: the emitted return type differs"
      lengths := (lengths ++ scenario.transactions.map (·.length.val)).eraseDups
      cases := cases.push json
  for length in Solcore.Synthesis.Source.BytesReturn.lengthBank do
    ensure (lengths.contains length) s!"generation never drew length {length}"
  ensure (lengths.all (· ≤ 64) && lengths.any (fun length => length % 32 != 0 && !Solcore.Synthesis.Source.BytesReturn.lengthBank.contains length))
    "generation drew a length above 64 or no uniform partial-Word length"
  -- Reductions: a shorter length comes with every non-empty one, and every
  -- emitted candidate replays as a strictly smaller sealed case.
  for json in cases.toList.take 6 do
    let source ← get (Solcore.Synthesis.Source.BytesReturn.caseProgram json)
    let reduced := Solcore.Synthesis.Source.BytesReturn.reductions source
    ensure (!reduced.isEmpty) "a case has no reduction"
    ensure (Solcore.Synthesis.Source.BytesReturn.totalLength source == 0 || reduced.any (fun candidate =>
        candidate.candidate.transactions.length == source.transactions.length &&
        Solcore.Synthesis.Source.BytesReturn.totalLength candidate.candidate <
          Solcore.Synthesis.Source.BytesReturn.totalLength source))
      "no shorter length"
    let shrunk ← get (Solcore.Synthesis.Source.BytesReturn.shrinkCases json 64 fuel)
    for candidate in ← get (shrunk.getObjValAs? (Array Json) "cases") do
      ensure ((Solcore.Synthesis.Source.BytesReturn.replayCase candidate fuel).toOption == some candidate)
        "a reduction does not replay"
      sameAsModel (← get (Solcore.Synthesis.Source.BytesReturn.caseProgram candidate)) fuel "reduction"
  -- A length above 64 is refused even with its own calldata, and so is a
  -- length that differs from the calldata.
  let some json := cases[0]? | throw (IO.userError "no case")
  let transactions ← get (json.getObjValAs? (Array Json) "transactions")
  let first := transactions[0]!
  let flags ← get (first.getObjValAs? String "flags")
  let input ← get (first.getObjValAs? String "input")
  let some flagsValue := flags.toNat? | throw (IO.userError "invalid flags")
  let some inputValue := input.toNat? | throw (IO.userError "invalid input")
  let overlong := first.setObjVal! "length" (toJson "65") |>.setObjVal! "calldata"
    (toJson (BytesReturnExecution.calldata (Word.ofNatModulo flagsValue) (Word.ofNatModulo inputValue) (Word.ofNatModulo 65)))
  ensure (Solcore.Synthesis.Source.BytesReturn.caseProgram
      (json.setObjVal! "transactions" (.arr (transactions.set! 0 overlong)))).toOption.isNone
    "a length above 64 was admitted"
  let length ← get (first.getObjValAs? String "length")
  ensure (Solcore.Synthesis.Source.BytesReturn.caseProgram (json.setObjVal! "transactions" (.arr (transactions.set! 0
      (first.setObjVal! "length" (toJson (if length == "1" then "2" else "1"))))))).toOption.isNone
    "a length that differs from its calldata was admitted"
  let plan ← get (json.getObjVal? "bytesReturnPlan")
  ensure (Solcore.Synthesis.Source.BytesReturn.checkedPlan (plan.setObjVal! "arity" (toJson 2))).toOption.isNone
    "a plan with an extra field was admitted"

end Tests.SourceBytesReturnCases
