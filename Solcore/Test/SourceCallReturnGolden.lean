private def wordHex (value : Word) : String :=
  let digits := Nat.toDigits 16 value.val
  String.ofList (List.replicate (64 - digits.length) '0' ++ digits)

private def recordText (words : List Word) : String := "record:" ++ String.join (words.map wordHex)

private def decisionText : CallReturnExecution.Decision → String
  | .ok record => recordText record.toList
  | .error data => "reject:" ++ encodeBytesText data

private def parentAddress : Address := ⟨0x20, by decide⟩
private def callerAddress : Address := ⟨0x40, by decide⟩

/-- The resume phase over the kept input 0, the returned status and the data,
read back as a decision: a rejection by its revert Word, or the record in
slots 2 to 6, checked against slot 1 and the returned sum. -/
private def resumeText (kind : Kind) (data : ByteArray) : Except String String := do
  let program := CallReturn.resumeProgram kind
  if checked : program.check = true then
    let contract := CheckedCoreContract.wordOutcomeV1
      ⟨program.toCore, Solcore.Core.Wire.Program.check_promotes_current checked⟩ rfl
    let world := WorldState.empty.putAccount parentAddress (Account.empty.withCode contract.code)
    let input := encodeWordBytesBE Word.zero ++ encodeWordBytesBE (w 1) ++ data
    if bounded : input.size < Solcore.Core.wordModulus then
      let invocation : TopLevelInvocation := {
        target := parentAddress, caller := callerAddress, callValue := Word.zero, inputData := ⟨input, bounded⟩ }
      match CallResumeExecution.phase? contract world invocation 1000000 with
      | some (.completed result) =>
          match result.outcome with
          | .returned bytes =>
              let slots := (List.range 7).map fun slot =>
                ((result.finalWorld.account? parentAddress).map fun account => account.storageRead (w slot)).getD Word.zero
              let record := slots.drop 2
              unless slots.getD 1 Word.zero == w (1 + 2 * data.size) do throw "slot 1 is not the flag and twice the size"
              unless bytes == encodeWordBytesBE (record.foldl (· + ·) Word.zero) do throw "the returned Word is not the sum"
              return recordText record
          | .reverted bytes =>
              if bytes == encodeWordBytesBE Word.zero then return "reject:0x"
              else if bytes == encodeWordBytesBE (w StdDispatch.truncatedError) then return "reject:0x08638556"
              else throw ("an unexpected revert Word " ++ encodeBytesText bytes)
          | .trapped _ => throw "the resume phase trapped"
      | _ => throw "the resume phase did not complete"
    else throw "the input exceeds a Word's size"
  else throw "the resume phase failed admission"

def testSourceCallReturnGolden : IO Unit := do
  ensure (rows.length == 58) "the golden rows changed"
  for (name, kind, data, expected) in rows do
    let some bytes := decodeBytesText? data | throw (IO.userError s!"{name}: invalid row data")
    ensure (decisionText (CallReturnExecution.decide (kindOf kind) bytes) == expected)
      s!"{name}: the byte-level model differs from its golden decision"
    ensure ((← get (resumeText (kindOf kind) bytes)) == expected)
      s!"{name}: original Core's resume phase differs from its golden decision"
  -- A changed row fails: the first record Word and the rejection kind flipped.
  let (name, kind, data, expected) := rows.getD 4 ("", "", "", "")
  let some bytes := decodeBytesText? data | throw (IO.userError "invalid row data")
  ensure (decisionText (CallReturnExecution.decide (kindOf kind) bytes) != expected.replace "record:" "record:1")
    s!"{name}: a changed record still matched"
  let (name, kind, data, _) := rows.getD 0 ("", "", "", "")
  let some bytes := decodeBytesText? data | throw (IO.userError "invalid row data")
  ensure ((← get (resumeText (kindOf kind) bytes)) != "reject:0x") s!"{name}: a changed rejection still matched"

end Tests.SourceCallReturnGolden
