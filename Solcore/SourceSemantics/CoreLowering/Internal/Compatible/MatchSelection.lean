        obtain ⟨bodyState, bodyRelated, bodyReady⟩ := bodyPost
        exact ⟨result, finalStore, finalMap, finalWorld, agreement.wrap bodyEval, restore_rep related environment,
          finalHeapRep, firstMaps.trans (secondMaps.trans thirdMaps), firstWorlds.trans (secondWorlds.trans thirdWorlds),
          firstFrame.trans (secondFrame.trans thirdFrame),
          firstMetadata.trans ((Dynamic.HeapMetadataExtend.of_allocation sourceHidden).trans thirdMetadata),
          ⟨returnTo.restore bodyState, protocol.trans firstRelated
            (protocol.trans selectionRelated (protocol.trans bodyRelated (returnTo.related bodyState))),
            transfers.post_parent returnTo bodyState environment bodyReady⟩⟩
  | @noBranch sourceNode sourceValue middle hidden location exprSize contains sourceEval exprSmaller sourceHidden selected =>
    have nodeEq : sourceNode = node := Option.some.inj
      ((lookupExpression?_complete unique contains).symm.trans found)
    subst sourceNode
    obtain ⟨value, middleStore, middleMap, middleWorld, coreEval, represented, middleRelated,
      firstMaps, firstWorlds, firstFrame, firstMetadata, firstPost⟩ :=
      expressionMeaning contextValid _ exprSmaller expression found scrutineeFacts environments heaps locals agrees actualTyped initial ready (.value sourceEval)
    obtain ⟨middleState, firstRelated, firstReady⟩ := firstPost
    cases represented with
    | value represented =>
