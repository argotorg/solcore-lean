/-- Constant-time dotted-table index after selecting the production row. -/
def dottedStaticIndex (dotted : DottedRhs) : Nat :=
  (dottedStaticProductionOffsets[dotted.production.index]?).getD 0 +
    dotted.dot.val

private abbrev dottedStaticValueAt
    (values : List Nat) (dotted : DottedRhs) : Nat :=
  (values.toArray[dottedStaticIndex dotted]?).getD 0

/-- SCC-condensation rank of a fixed-grammar dotted RHS. -/
def dottedStaticComponentRank (dotted : DottedRhs) : Nat :=
  dottedStaticValueAt dottedStaticComponentValues dotted

/-- Nullable-completion phase inside one SCC. -/
def dottedStaticPhase (dotted : DottedRhs) : Nat :=
  dottedStaticValueAt dottedStaticPhaseValues dotted

/-- The dotted position before a production has recognized a symbol. -/
def dottedStaticStart (production : ProductionId) : DottedRhs := {
  production
  dot := ⟨0, Nat.zero_lt_succ _⟩
}

/-- Advance one legal incomplete dotted position. -/
def dottedStaticAdvance (dotted : DottedRhs)
    (incomplete : dotted.dot.val < dotted.production.rhs.length) :
    DottedRhs := {
  production := dotted.production
  dot := ⟨dotted.dot.val + 1, Nat.succ_lt_succ incomplete⟩
}

/-- The completed dotted position of one production. -/
def dottedStaticComplete (production : ProductionId) : DottedRhs := {
  production
  dot := ⟨production.rhs.length, Nat.lt_succ_self _⟩
}

/-- Completion decrease certified by the static SCC and phase tables. -/
def DottedStaticCompletionDecrease
    (waiting : DottedRhs) (child : ProductionId)
    (incomplete : waiting.dot.val < waiting.production.rhs.length) : Prop :=
  let after := dottedStaticAdvance waiting incomplete
  let finished := dottedStaticComplete child
  dottedStaticComponentRank after <
      dottedStaticComponentRank finished ∨
    dottedStaticComponentRank after =
        dottedStaticComponentRank finished ∧
      (dottedStaticPhase after < dottedStaticPhase finished ∨
        dottedStaticPrefixConsumes waiting = true)

/-- Prediction edge check for one waiting/child pair. -/
def dottedStaticPredictionRankCell
    (waiting : DottedRhs) (child : ProductionId) : Bool :=
  if incomplete : waiting.dot.val < waiting.production.rhs.length then
    match waiting.production.rhs[waiting.dot.val] with
    | .terminal _ => true
    | .nonterminal lhs =>
        if child.lhs = lhs then
          if child.rhs = [] then
            true
          else
            decide (dottedStaticComponentRank (dottedStaticStart child) <
              dottedStaticComponentRank waiting)
        else
          true
  else
    true

/-- Direct epsilon edge check for one waiting/child pair. -/
def dottedStaticEpsilonRankCell
    (waiting : DottedRhs) (child : ProductionId) : Bool :=
  if incomplete : waiting.dot.val < waiting.production.rhs.length then
    match waiting.production.rhs[waiting.dot.val] with
    | .terminal _ => true
    | .nonterminal lhs =>
        if child.lhs = lhs then
          if child.rhs = [] then
            decide (dottedStaticComponentRank
                (dottedStaticAdvance waiting incomplete) <
              dottedStaticComponentRank waiting)
          else
            true
        else
          true
  else
    true

/-- Completion edge check for one waiting/child pair. -/
def dottedStaticCompletionRankCell
    (waiting : DottedRhs) (child : ProductionId) : Bool :=
  if incomplete : waiting.dot.val < waiting.production.rhs.length then
    match waiting.production.rhs[waiting.dot.val] with
    | .terminal _ => true
    | .nonterminal lhs =>
        if child.lhs = lhs then
          let after := dottedStaticAdvance waiting incomplete
          let finished := dottedStaticComplete child
          decide (dottedStaticComponentRank after <
              dottedStaticComponentRank finished) ||
            (decide (dottedStaticComponentRank after =
                dottedStaticComponentRank finished) &&
              (decide (dottedStaticPhase after <
                  dottedStaticPhase finished) ||
                dottedStaticPrefixConsumes waiting))
        else
          true
  else
    true

/-- Combined static edge check for one waiting/child pair. -/
def dottedStaticRankCell
    (waiting : DottedRhs) (child : ProductionId) : Bool :=
  dottedStaticPredictionRankCell waiting child &&
    dottedStaticEpsilonRankCell waiting child &&
    dottedStaticCompletionRankCell waiting child

/-- Expanded productions with one requested left-hand side. -/
def dottedStaticProductionsFor
    (lhs : NonterminalSymbol) : List ProductionId :=
  allProductionIds.filter fun child => decide (child.lhs = lhs)

/-- Sparse row check, restricted to productions selectable at the dot. -/
def dottedStaticRankRow (waiting : DottedRhs) : Bool :=
  if incomplete : waiting.dot.val < waiting.production.rhs.length then
    match waiting.production.rhs[waiting.dot.val] with
    | .terminal _ => true
    | .nonterminal lhs =>
        (dottedStaticProductionsFor lhs).all
          (dottedStaticRankCell waiting)
  else
    true

/-- A consuming-prefix certificate excludes an all-nullable prefix. -/
theorem dottedStaticPrefixConsumes_sound (dotted : DottedRhs)
    (consumes : dottedStaticPrefixConsumes dotted = true) :
    (dotted.production.rhs.take dotted.dot.val).all
        dottedStaticNullableSymbol ≠ true := by
  have nullable :=
    (dottedStaticPrefixConsumes_eq_true_iff dotted).mp consumes
  simpa [dottedStaticPrefixNullable] using nullable

end Solcore.Surface.Multi
