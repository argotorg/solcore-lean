/-- Nullability of one fixed-grammar EBNF expression. -/
def dottedStaticNullableExpr : EbnfExpr → Bool
  | .atom (.terminal _) => false
  | .atom (.nonterminal rule) => nullableGrammarRules.contains rule
  | .sequence children =>
      (dottedStaticNullableExprValues children).all id
  | .group child => dottedStaticNullableExpr child
  | .choice branches =>
      (dottedStaticNullableExprValues branches).any id
  | .optional _ => true
  | .star _ => true
  | .plus child => dottedStaticNullableExpr child
  | .list0 _ => true
  | .list1 element => dottedStaticNullableExpr element

/-- Pointwise nullability used by variadic EBNF nodes. -/
def dottedStaticNullableExprValues : List EbnfExpr → List Bool
  | [] => []
  | head :: tail =>
      dottedStaticNullableExpr head ::
        dottedStaticNullableExprValues tail

end

/-- Nullability of one expanded fixed-grammar nonterminal. -/
def dottedStaticNullableNonterminal : NonterminalSymbol → Bool
  | .rule rule => nullableGrammarRules.contains rule
  | .aux site => dottedStaticNullableExpr site.expression
  | .tail _ => true

/-- Nullability of one expanded fixed-grammar symbol. -/
def dottedStaticNullableSymbol : GrammarSymbol → Bool
  | .terminal _ => false
  | .nonterminal nonterminal =>
      dottedStaticNullableNonterminal nonterminal

/-- Whether every symbol strictly before this dot is nullable. -/
def dottedStaticPrefixNullable (dotted : DottedRhs) : Bool :=
  (dotted.production.rhs.take dotted.dot.val).all
    dottedStaticNullableSymbol

/-- Whether the prefix strictly before this dot must consume input. -/
def dottedStaticPrefixConsumes (dotted : DottedRhs) : Bool :=
  !dottedStaticPrefixNullable dotted

theorem dottedStaticPrefixConsumes_eq_true_iff
    (dotted : DottedRhs) :
    dottedStaticPrefixConsumes dotted = true ↔
      dottedStaticPrefixNullable dotted = false := by
  simp [dottedStaticPrefixConsumes]

